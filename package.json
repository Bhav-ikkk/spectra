{
  "name": "spectra",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "benchmark:smoke": "tsx packages/core/src/scripts/benchmark-smoke.ts",
    "benchmark:referee": "tsx packages/sdk/src/scripts/run-full-benchmark.ts",
    "workbench:bundle": "pnpm --filter @spectra/workbench bundle-data",
    "workbench:dev": "pnpm --filter @spectra/workbench dev",
    "build:all": "pnpm -r build",
    "spectra": "node packages/cli/dist/index.js",
    "start": "pnpm --filter @spectra/workbench start"
  },
  "packageManager": "pnpm@9.15.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "ffmpeg-static"
    ]
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@typescript-eslint/eslint-plugin": "~8.11.0",
    "@typescript-eslint/parser": "~8.11.0",
    "eslint": "~9.13.0",
    "ffmpeg-static": "^5.3.0",
    "playwright": "^1.64.1",
    "prettier": "~3.3.3",
    "tsx": "~4.19.1",
    "typescript": "~5.6.3",
    "vitest": "~2.1.4"
  }
}
