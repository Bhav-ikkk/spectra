# Meta AI API key for SAM 3.1 Responses API and Muse Spark evaluations
# Never commit the actual .env file with your key!
META_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1

# Baseten API key for Meta open-weight model: meta-models/muse-spark-open-1026
# Endpoint: POST https://inference.baseten.co/v1/chat/completions
# Qualifies Spectra for the $10,000 "Best Build on Meta Open Weight Models" prize
BASETEN_API_KEY=
BASETEN_BASE_URL=https://inference.baseten.co/v1

# Bearer [REDACTED] for the workbench /api/* routes (prod-server + vite dev plugin).
# When set (non-empty), every /api/* request must send:
#   Authorization: Bearer <token>
# When empty/unset, the API stays open for local development and demos.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SPECTRA_API_TOKEN=
